<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.projetjavafx.root.jobFeed.JobFeedController"
             stylesheets="@css/job-feed.css">
    <!-- TOP BAR -->
    <top>
        <HBox spacing="10" style="-fx-background-color: #34495e; -fx-padding: 10;">
            <Label text="Job Feed" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Home" fx:id="homeButton" style="-fx-background-color: transparent; -fx-text-fill: white;"/>
            <Button text="Profile" fx:id="profileButton" style="-fx-background-color: transparent; -fx-text-fill: white;"/>
            <Button text="Logout" fx:id="logoutButton" style="-fx-background-color: red; -fx-text-fill: white;"/>
        </HBox>
    </top>

    <!-- SIDE BAR -->
    <left>
        <VBox spacing="10" style="-fx-background-color: #2c3e50; -fx-padding: 15;">
            <Button text="Dashboard" fx:id="dashboardButton" style="-fx-background-color: transparent; -fx-text-fill: white;"/>
            <Button text="Events" fx:id="eventsButton" style="-fx-background-color: transparent; -fx-text-fill: white;"/>
            <Button text="Job Feed" fx:id="jobFeedButton" style="-fx-background-color: #1abc9c; -fx-text-fill: white;"/>
            <Button text="Groups" fx:id="groupsButton" style="-fx-background-color: transparent; -fx-text-fill: white;"/>
            <Button text="Settings" fx:id="settingsButton" style="-fx-background-color: transparent; -fx-text-fill: white;"/>
        </VBox>
    </left>

    <!-- JOB FEED SCROLL VIEW -->
    <center>
        <ScrollPane fx:id="scrollPane">
            <content>
                <FlowPane fx:id="jobsContainer"
                          style="-fx-background-color: #f5f5f5;"
                          hgap="20" vgap="20"
                          alignment="CENTER">
                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20"/>
                    </padding>
                </FlowPane>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
