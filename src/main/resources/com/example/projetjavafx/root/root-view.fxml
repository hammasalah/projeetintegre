<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="1050" prefWidth="1920" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.projetjavafx.root.RootController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-background-color: #2c3e50; -fx-padding: 10; -fx-pref-width: 100%;">
            <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #008080;" text="Connect Sphere" />
            <Pane HBox.hgrow="ALWAYS" />
            <HBox alignment="TOP_RIGHT" spacing="15">
                <Button fx:id="loginButton" onAction="#onLoginClick" style="-fx-background-color: #008080; -fx-text-fill: white;" text="Login" />
                <Button fx:id="registerButton" onAction="#onRegisterClick" style="-fx-background-color: #008080; -fx-text-fill: white;" text="Register" />
            </HBox>
        </HBox>
    </top>

    <left>
        <VBox alignment="TOP_LEFT" prefWidth="250" spacing="15" style="-fx-background-color: #2c3e50; -fx-padding: 20;">
            <Button fx:id="eventsButton" onAction="#onEventsClick" style="-fx-text-fill: white; -fx-background-color: #048c7f;" text="Events" />
            <Button fx:id="organizerButton" onAction="#onOrganizerButtonClick" style="-fx-text-fill: white; -fx-background-color: #048c7f;" text="Organizer" />
            <Button fx:id="profileButton" onAction="#onProfileClick" style="-fx-text-fill: white; -fx-background-color: #048c7f;" text="Profile" />
            <Button fx:id="groupButton" onAction="#onGroupButtonClick" style="-fx-text-fill: white; -fx-background-color: #048c7f;" text="Group" />
            <Button fx:id="createJobButton" onAction="#onCreateJobClick" style="-fx-text-fill: white; -fx-background-color: #4a148c;" text="Create Job" />
         <Button fx:id="jobButton" mnemonicParsing="false" onAction="#onJobFeedClick" text="jobs" />

        </VBox>
    </left>


    <center>
        <VBox alignment="CENTER" spacing="20" style="-fx-padding: 20;">
            <Label style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Connect Sphere: Your Gateway to Unforgettable Events">
            </Label>

            <Label style="-fx-font-size: 18px; -fx-text-fill: #34495e;" text="Create, participate, and even work at the events that inspire you." />

            <HBox alignment="CENTER" spacing="20">
                <VBox alignment="CENTER" spacing="10">
                    <ImageView fitHeight="100" fitWidth="100" preserveRatio="true" />
                    <Label style="-fx-font-weight: bold;" text="Create Events" />
                    <Label text="Plan and manage your own events with ease." />
                </VBox>

                <VBox alignment="CENTER" spacing="10">
                    <ImageView fitHeight="100" fitWidth="100" preserveRatio="true" />
                    <Label style="-fx-font-weight: bold;" text="Find Events" />
                    <Label text="Discover exciting events happening near you." />
                </VBox>

                <VBox alignment="CENTER" spacing="10">
                    <ImageView fitHeight="100" fitWidth="100" preserveRatio="true" />
                    <Label style="-fx-font-weight: bold;" text="Work at Events" />
                    <Label text="Find job opportunities at various events." />
                </VBox>
            </HBox>

            <HBox alignment="CENTER" spacing="10">
                <Button onAction="#onEventsClick" style="-fx-background-color: #008080; -fx-text-fill: white; -fx-padding: 10;" text="Explore Events" />
                <Button onAction="#onOrganizerButtonClick" style="-fx-background-color: #008080; -fx-text-fill: white; -fx-padding: 10;" text="Create an Event" />
            </HBox>
        </VBox>
    </center>
</BorderPane>
