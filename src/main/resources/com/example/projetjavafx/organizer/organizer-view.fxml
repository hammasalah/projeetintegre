<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane stylesheets="@css/orgnaizer.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.projetjavafx.root.organizer.OrganizerController">

    <!-- Left Sidebar -->
    <left>
        <VBox alignment="TOP_LEFT" prefWidth="250" spacing="15" style="-fx-background-color: #2c3e50; -fx-padding: 20;">
            <!-- Application Title -->
            <Label style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold;" text="Event Manager Pro" />

            <!-- Navigation Buttons -->
            <VBox spacing="10">
                <Button style="-fx-text-fill: white; -fx-background-color: #048c7f;"
                        text="Home" onAction="#handleHomeButton" />
                <Button style="-fx-text-fill: white; -fx-background-color: #048c7f;"
                        text="Analytics" onAction="#onAnalyticsClick" />
                <Button style="-fx-text-fill: white; -fx-background-color: #048c7f;"
                        text="Create Event" />
                <Button style="-fx-text-fill: white; -fx-background-color: #4a148c;"
                        text="Create Job Post" onAction="#onCreateJobClick" />
            </VBox>

            <!-- User Profile Section -->
            <VBox spacing="5" style="-fx-padding: 15; -fx-background-color: #34495e;">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <ImageView fitHeight="40" fitWidth="40" style="-fx-background-radius: 20;" />
                    <VBox>
                        <Label style="-fx-text-fill: white; -fx-font-weight: bold;" text="Admin Name" />
                        <Label style="-fx-text-fill: #bdc3c7;" text="Organizer" />
                    </VBox>
                </HBox>
            </VBox>
        </VBox>
    </left>

    <!-- Center Content -->
    <center>
        <VBox spacing="20" style="-fx-padding: 20;">
            <!-- Event Management Section -->
            <VBox spacing="10">
                <HBox alignment="CENTER_LEFT" spacing="20">
                    <Label style="-fx-font-size: 18px; -fx-text-fill: #2c3e50; -fx-font-weight: bold;" text="Event Management" />
                    <Button style="-fx-background-color: #4a148c; -fx-text-fill: white;" text="+ New Event" />
                </HBox>

                <TableView fx:id="eventsTable" style="-fx-background-color: white;">
                    <columns>
                        <TableColumn fx:id="eventNameColumn" prefWidth="150" text="Name" />
                        <TableColumn fx:id="eventDescColumn" prefWidth="250" text="Description" />
                        <TableColumn fx:id="eventStartColumn" prefWidth="120" text="Start Time" />
                        <TableColumn fx:id="eventEndColumn" prefWidth="120" text="End Time" />
                        <TableColumn fx:id="eventLocationColumn" prefWidth="120" text="Location" />
                    </columns>
                </TableView>
            </VBox>

            <!-- Job Management Section -->
            <VBox spacing="10">
                <HBox alignment="CENTER_LEFT" spacing="20">
                    <Label style="-fx-font-size: 18px; -fx-text-fill: #2c3e50; -fx-font-weight: bold;" text="Job Post Management" />
                    <Button onAction="#onNewJobPostClick" style="-fx-background-color: #d81b60; -fx-text-fill: white;" text="+ New Job Post" />
                </HBox>

                <TableView fx:id="jobsTable" style="-fx-background-color: white;">
                    <columns>
                        <TableColumn fx:id="jobTitleColumn" prefWidth="150" text="Job Title" />
                        <TableColumn fx:id="eventTitleColumn" prefWidth="120" text="Event Title" />
                        <TableColumn fx:id="jobLocationColumn" prefWidth="100" text="Location" />
                        <TableColumn fx:id="employmentTypeColumn" prefWidth="100" text="Employment Type" />
                        <TableColumn fx:id="applicationDeadlineColumn" prefWidth="100" text="Deadline" />
                        <TableColumn fx:id="minSalaryColumn" prefWidth="80" text="Min Salary" />
                        <TableColumn fx:id="maxSalaryColumn" prefWidth="80" text="Max Salary" />
                        <TableColumn fx:id="currencyColumn" prefWidth="60" text="Currency" />
                        <TableColumn fx:id="jobDescColumn" prefWidth="200" text="Description" />
                        <TableColumn fx:id="recruiterNameColumn" prefWidth="120" text="Recruiter Name" />
                        <TableColumn fx:id="recruiterEmailColumn" prefWidth="150" text="Recruiter Email" />
                        <TableColumn fx:id="createdAtColumn" prefWidth="120" text="Created At" />
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>
